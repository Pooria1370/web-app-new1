{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-new1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7d31ec31-198a-45b7-bbb6-39f3fde5378f","database_name": "web-app-new1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "917e4d37a60d4e19a99c7299cd3d0d8a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
